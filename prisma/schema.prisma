// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id               String   @id @default(cuid())

  fullName         String?
  jobTitle         String?
  company          String?

  mobileNumbers    String[]
  telephoneNumbers String[]

  emails           String[]

  website          String?
  address          String?
  companyLocation  String?

  linkedin         String?

  rawNotes         String?

  // Public URL of the card image. The bucket is public_read, so the stored URL
  // renders directly. The object key is not kept: nothing reads it back, and
  // cleanup deletes within the same request that uploaded the object.
  originalImageUrl String?

  // Subsidiaries this contact's company matched during the latest matching run.
  subsidiaryMatches   String[]  @default([])
  subsidiaryMatchedAt DateTime?

  createdAt        DateTime @default(now())

  enrichment Enrichment? 

  @@index([emails], type: Gin)
  @@index([mobileNumbers], type: Gin)
  @@index([telephoneNumbers], type: Gin)
  @@index([createdAt(sort: Desc)])
  @@index([fullName, company])
  @@index([subsidiaryMatches], type: Gin)
}

enum KeywordRole {
  OWN_BUSINESS
  TECHNICAL
  DEMAND_SIDE
  PROCUREMENT
}

enum NegativeStrength {
  VETO
  PENALTY
}

enum CompanyScoreStatus {
  OK
  NO_DATA
}

model SubsidiaryKeyword {
  id               String           @id @default(cuid())
  subsidiary       String
  threshold        Float            @default(0.5)
  phrase           String
  category         String
  role             KeywordRole
  negativeStrength NegativeStrength?
  aliasGroup       String?
  createdAt        DateTime         @default(now())

  @@unique([subsidiary, phrase])
  @@index([subsidiary])
  @@map("subsidiary_keyword")
}

model CompanyKeywordScore {
  id             String             @id @default(cuid())
  company        String
  // Empty-string sentinel represents per-company header row; don't use NULL,
  // because PostgreSQL unique indexes permit multiple NULLs.
  keyword        String             @default("")
  scores         Json?
  status         CompanyScoreStatus @default(OK)
  extractVersion String
  scoreVersions  Json?
  sources        Json?
  fetchedAt      DateTime           @default(now())

  @@unique([company, keyword])
  @@index([keyword])
  @@index([company])
  @@map("company_keyword_score")
}

model CompanyReview {
  id             String   @id @default(cuid())
  company        String   @unique
  reason         String
  phrases        Json?
  sharedPhrases  Json?
  extractVersion String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@map("company_review")
  @@index([reason])
}

enum Role {
  USER
  ADMIN
  DEVELOPER
}

model User {
  id        String   @id @default(cuid())

  name      String

  email     String   @unique

  password  String

  image     String?

  role      Role     @default(USER)

  mustResetPassword Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  DONE
  PARTIAL
  FAILED
}

model Enrichment {
  contact_id            String            @id
  status                EnrichmentStatus  @default(PENDING)
  attempts              Int               @default(0)
  completed             Int               @default(0)
  failed                Int               @default(0)
  expected              Int               @default(0)

  linkedin_url          String?
  linkedin_photo_url    String?
  avatar_url            String?
  facebook_url          String?
  twitter_url           String?
  instagram_url         String?
  other_profiles        String?

  company_details       String?
  company_core_business String?
  official_site         String?
  sources               String?
  location              String?

  address_line1         String?
  address_line2         String?
  city                  String?
  state                 String?
  postal_code           String?
  country               String?
  address_verified_at   DateTime?
  address_attempts      Int               @default(0)

  career_background     String?
  summary               String?

  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  enriched_at           DateTime?

  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@map("enrichment")

  @@index([status])
}

model PasswordResetToken {
  id        String @id @default(cuid())

  email     String

  token     String @unique

  passwordHash String?

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model LocationCache {
  id               String   @id @default(cuid())
  query            String   @unique
  latitude         Float?
  longitude        Float?
  resolved         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  placeId          String?
  formattedAddress String?
  country          String?
  state            String?
  expiresAt        DateTime?
  normalizedQuery  String   @unique
}
