// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id               String   @id @default(cuid())

  fullName         String?
  jobTitle         String?
  company          String?

  mobileNumbers    String[]
  telephoneNumbers String[]

  emails           String[]

  website          String?
  address          String?
  companyLocation  String?

  linkedin         String?

  rawNotes         String?

  createdAt        DateTime @default(now())

  enrichment Enrichment? 
}

enum Role {
  USER
  ADMIN
  DEVELOPER
}

model User {
  id        String   @id @default(cuid())

  name      String

  email     String   @unique

  password  String

  image     String?

  role      Role     @default(USER)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  DONE
  PARTIAL
  FAILED
}

model Enrichment {
  contact_id            String            @id
  status                EnrichmentStatus  @default(PENDING)
  attempts              Int               @default(0)
  completed             Int               @default(0)
  failed                Int               @default(0)
  expected              Int               @default(0)

  linkedin_url          String?
  linkedin_photo_url    String?
  avatar_url            String?
  facebook_url          String?
  twitter_url           String?
  instagram_url         String?
  other_profiles        String?

  company_details       String?
  company_core_business String?
  official_site         String?
  sources               String?
  location              String?
  career_background     String?
  summary               String?

  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  enriched_at           DateTime?

  contact Contact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@map("enrichment")
}

model PasswordResetToken {
  id        String @id @default(cuid())

  email     String

  token     String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())
}